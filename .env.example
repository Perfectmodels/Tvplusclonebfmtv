# Copier vers .env puis renseigner les valeurs depuis le dashboard Supabase > Project Settings > API
SUPABASE_URL=https://eygxwssajyhbnusouwfk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://eygxwssajyhbnusouwfk.supabase.co/auth/v1/.well-known/jwks.json

# Facultatif : URL HLS du direct TV Plus (ex: https://.../master.m3u8)
NEXT_PUBLIC_LIVE_STREAM_URL=

# Facultatif : secret pour /api/cron/refresh-rss (sinon SUPABASE_SECRET_KEY est utilisé)
CRON_SECRET=

# La base TV+ V2 contient des tables différentes du schéma initial de ce clone.
# Lecture publique RLS uniquement. Le back-office du clone n'est PAS compatible.
SUPABASE_SCHEMA_MODE=tvplus-v2
# SUPABASE_SECRET_KEY doit rester vide pour ce mode lecture seule.
# Ne jamais committer un fichier .env contenant des clés ou mots de passe.

# V3: URL HTTPS de l'API PHP LWS; variables exclusivement serveur.
LWS_EDITORIAL_API_URL=
LWS_EDITORIAL_SERVICE_KEY=
# Conserver Supabase pour les sessions et rôles pendant la transition.

# Veille rédactionnelle : clé Groq serveur et modèle facultatif
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
