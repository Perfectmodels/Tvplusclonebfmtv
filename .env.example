# Copier vers .env puis renseigner les valeurs depuis le dashboard Supabase > Project Settings > API
SUPABASE_URL=https://VOTRE_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://VOTRE_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Facultatif : URL HLS du direct TV Plus (ex: https://.../master.m3u8)
LIVE_STREAM_URL=

# Facultatif : secret pour /api/cron/refresh-rss (sinon SUPABASE_SECRET_KEY est utilisé)
CRON_SECRET=
